# Cloudflare Workers AI (primary) — required for the default provider.
# Next.js loads these from .env.local (never commit real values).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional per-slot Cloudflare API tokens (recommended)
CLOUDFLARE_HAIKU_API_TOKEN=
CLOUDFLARE_GEMINI_API_TOKEN=
CLOUDFLARE_MUSE_API_TOKEN=
CLOUDFLARE_GPT_API_TOKEN=

# Optional per-slot Cloudflare model overrides (must be @cf/... ids)
CLOUDFLARE_HAIKU_MODEL=@cf/meta/llama-3.1-8b-fast-v2
CLOUDFLARE_GEMINI_MODEL=@cf/meta/llama-3.1-8b-fast-v2
CLOUDFLARE_MUSE_MODEL=@cf/meta/llama-3.1-8b-fast-v2
CLOUDFLARE_GPT_MODEL=@cf/meta/llama-3.1-8b-fast-v2

# Fallback providers (register automatically when credentials exist)
GOOGLE_GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Auralink
OPENAI_API_KEY=
HF_TOKEN=
OLLAMA_BASE_URL=http://127.0.0.1:11434
